{
  "name": "picoddy",
  "version": "3.4.2",
  "license": "MIT",
  "description": "PiCoddy — AI-powered desktop agent",
  "author": "PiCoddy",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "dev": "echo \"请使用 npm run electron:dev 启动Electron 应用，或 cd frontend && npm run dev 启动前端开发服务器\"",
    "dev:win": "electron .",
    "start": "electron .",
    "build": "node scripts/clean-electron-builder-output.mjs current && npm run build:frontend && npm run prepare:runtime:current && electron-builder",
    "prepare:runtime:current": "node scripts/runtime/prepare-runtime.mjs --current",
    "prepare:runtime:mac:arm64": "node scripts/runtime/prepare-runtime.mjs --platform darwin --arch arm64",
    "prepare:runtime:mac:x64": "node scripts/runtime/prepare-runtime.mjs --platform darwin --arch x64",
    "prepare:runtime:win:ia32": "node scripts/runtime/prepare-runtime.mjs --platform win32 --arch ia32",
    "prepare:runtime:win:x64": "node scripts/runtime/prepare-runtime.mjs --platform win32 --arch x64",
    "prepare:runtime:win:all": "npm run prepare:runtime:win:ia32 && npm run prepare:runtime:win:x64",
    "verify:runtime:package": "node scripts/runtime/verify-packaged-runtime.mjs",
    "build:mac": "node scripts/clean-electron-builder-output.mjs mac && npm run build:frontend && npm run prepare:runtime:current && node scripts/run-electron-builder.mjs --mac --dir",
    "build:mac:release": "node scripts/clean-electron-builder-output.mjs mac && npm run build:frontend && npm run prepare:runtime:current && node scripts/run-electron-builder.mjs --mac --publish never",
    "build:win:x64": "node scripts/clean-electron-builder-output.mjs win && npm run build:frontend && npm run prepare:runtime:win:x64 && node scripts/run-electron-builder.mjs --win --x64",
    "build:win:ia32": "node scripts/clean-electron-builder-output.mjs win && npm run build:frontend && npm run prepare:runtime:win:ia32 && node scripts/run-electron-builder.mjs --win --ia32",
    "build:win": "npm run build:win:x64",
    "build:win:clean": "npm run build:win",
    "electron:dev": "env NODE_ENV=development electron .",
    "electron:start": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "node scripts/testing/run-backend-tests.mjs",
    "test:backend:changed": "tsx --test",
    "gen:frontend": "npx tsx scripts/gen-frontend.ts",
    "gen:builtin-skills": "npx tsx scripts/build-builtin-skills.ts resources/builtin-skills src/agent/builtin_skills",
    "build:release": "node scripts/release/build.mjs",
    "release:ship": "node scripts/release/ship.mjs",
    "release:qiniu": "node --env-file-if-exists=.env.qiniu scripts/release/ship.mjs --provider qiniu",
    "release:qiniu:publish": "node --env-file-if-exists=.env.qiniu scripts/release/qiniu.mjs",
    "release:feed": "node scripts/release/feed.mjs",
    "build:win:msi": "npm run build:frontend && npm run prepare:runtime:win:x64 && node scripts/run-electron-builder.mjs --win msi --x64 --publish never"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@xenova/transformers": "^2.17.2",
    "clawhub": "0.23.3",
    "dingtalk-stream": "2.1.5",
    "docx": "^9.0.3",
    "docxtemplater": "^3.50.0",
    "electron-updater": "6.8.9",
    "esbuild": "^0.28.1",
    "exceljs": "^4.4.0",
    "ignore": "^7.0.6",
    "koffi": "^3.1.4",
    "mammoth": "^1.8.0",
    "npm": "11.7.0",
    "pdfjs-dist": "^4.0.379",
    "pizzip": "^3.1.8",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "saxes": "5.0.1",
    "semver": "7.7.4",
    "sqlite-vec": "^0.1.9",
    "tar": "6.2.1",
    "tsx": "^4.23.5",
    "typebox": "^1.1.38",
    "unified": "^11.0.5",
    "unzipper": "0.10.14",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "7.7.1",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "qiniu": "7.15.2",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "file:../esbuild@0.21.5/node_modules/esbuild": true,
    "file:../../esbuild@0.21.5/node_modules/esbuild": true,
    "electron@43.2.0": true
  },
  "productName": "PiCoddy"
}
