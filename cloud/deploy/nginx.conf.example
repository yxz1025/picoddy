# Place in nginx http context (e.g. /etc/nginx/conf.d/picoddy-cloud.conf).
# Replace cloud.example.com and certificate paths before nginx -t/reload.
limit_req_zone $binary_remote_addr zone=picoddy_login:10m rate=10r/m;
server {
    listen 80;
    server_name cloud.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name cloud.example.com;
    ssl_certificate /etc/nginx/certs/cloud.fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/cloud.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 40m;

    location = /api/auth/login {
        limit_req zone=picoddy_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        # Keep text/event-stream responsive rather than collecting output in blocks.
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
