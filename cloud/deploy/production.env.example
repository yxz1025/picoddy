# Reference only. ./deploy.sh init copies credentials from cloud/.env.
PUBLIC_ORIGIN=https://CHANGE_ME.example.com
SECURE_COOKIES=true
POSTGRES_PASSWORD=COPY_FROM_LOCAL
ENCRYPTION_KEY=COPY_FROM_LOCAL
# Same-server Compose service address.
SANDBOX_DOMAIN=http://opensandbox-server:8090
SANDBOX_API_KEY=CHANGE_ME
# deploy builds this task image on the same server.
SANDBOX_IMAGE=picoddy-cloud-sandbox:0.1.0
SANDBOX_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=2
# local: shared persistent Docker volume; or oss/s3 with the credentials below.
STORAGE_DRIVER=local
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-oss-bucket
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# STORAGE_ENDPOINT=https://your-s3-endpoint
# STORAGE_BUCKET=your-private-bucket
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# Optional enterprise SkillHub shared secret, supplied by your organization.
# SKILLHUB_AUTH_ACCESS_TOKEN_SECRET=

# 内网 HTTP 直接访问见 README；默认由宿主机 HTTPS 代理接入
ALLOW_INSECURE_HTTP=false
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# Deployment-specific authentication endpoints; disabled when empty.
CAS_LOGIN_URL=
CAS_EXCHANGE_URL=
SKILLHUB_BASE_URL=
