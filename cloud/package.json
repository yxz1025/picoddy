{
  "name": "picoddy-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "scheduler": "node --env-file-if-exists=.env --import tsx src/automation.ts",
    "web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/desktop/tsconfig.json",
    "build": "npm run generate:runtime && npm run typecheck && vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/init-db.ts",
    "admin": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "seed-skills": "node --env-file-if-exists=.env --import tsx scripts/seed-skills.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/live-sandbox-oss.ts",
    "test:sandbox:local": "node --import tsx scripts/local-sandbox-smoke.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "generate:runtime": "node --import tsx scripts/generate-portable-runtime.ts"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.1.1",
    "@aws-sdk/client-s3": "3.1149.0",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ali-oss": "6.23.0",
    "classnames": "^2.5.1",
    "cron-parser": "^5.0.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.2",
    "katex": "^0.18.4",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.17.0",
    "monaco-editor": "0.57.0",
    "pg": "8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "saxes": "5.0.1",
    "tsx": "^4.23.5",
    "typebox": "1.3.27",
    "yaml": "^2.9.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
